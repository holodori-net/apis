{
  "$schema": "https://unpkg.com/release-it@20/schema/release-it.json",
  "git": {
    "requireBranch": "main",
    "requireCleanWorkingDir": true,
    "requireUpstream": true,
    "commitMessage": "chore(release): v${version} [skip ci]",
    "tagName": "v${version}",
    "tagAnnotation": "Release v${version}"
  },
  "github": {
    "release": true,
    "releaseName": "v${version}"
  },
  "npm": {
    "publish": true
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "infile": "CHANGELOG.md",
      "preset": {
        "bumpStrict": true,
        "name": "conventionalcommits",
        "types": [
          {
            "type": "feat",
            "section": "Features"
          },
          {
            "type": "fix",
            "section": "Bug Fixes"
          },
          {
            "type": "perf",
            "section": "Performance"
          },
          {
            "type": "refactor",
            "section": "Refactoring"
          },
          {
            "type": "revert",
            "section": "Reverts"
          },
          {
            "type": "docs",
            "hidden": true
          },
          {
            "type": "test",
            "hidden": true
          },
          {
            "type": "ci",
            "hidden": true
          },
          {
            "type": "build",
            "hidden": true
          },
          {
            "type": "style",
            "hidden": true
          },
          {
            "type": "chore",
            "hidden": true
          }
        ]
      }
    }
  }
}
